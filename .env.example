# Copy this file to .env.local for local development.
# Every value the app needs is an env var — nothing environment-specific is hardcoded,
# so the same codebase boots on Vercel, another host, or a laptop just by changing these.

# Public base URL of this deployment (used to build links in emails, invites, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Settings -> API in the Supabase dashboard)
# NEXT_PUBLIC_SUPABASE_URL is required even if SUPABASE_URL is also set below -- browser
# code can only read NEXT_PUBLIC_-prefixed vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side code prefers these (matching Vercel's Supabase-integration naming) if present.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Server-only, never exposed to the browser. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (Settings -> Database -> Connection string -> Session pooler).
# Percent-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=

# Resend (resend.com/api-keys) - transactional email (invites, password reset relay, etc.)
RESEND_API_KEY=
EMAIL_FROM="Guest Squad CRM <noreply@crm.guestsquad.com>"

# Shared secret for machine-to-machine ingest endpoints (e.g. gscraper Google Maps import).
# Callers send it as: Authorization: Bearer <value>
INGEST_API_KEY=
